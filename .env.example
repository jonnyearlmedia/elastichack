# ── Copy to .env and fill in with the values you get in the room ──────────────
# Your Elasticsearch Serverless endpoint (Elastic hands this to you)
ES_URL=https://your-project.es.us-east-1.aws.elastic.cloud:443

# Your Elastic API key (create in Kibana → Stack Management → API keys)
ES_API_KEY=paste_your_api_key_here

# Kibana URL (same project, usually the ".kb." host) — for Agent Builder setup
KIBANA_URL=https://your-project.kb.us-east-1.aws.elastic.cloud:443

# The EIS chat-completion inference endpoint id.
# Find the real one in the room with:  python discover.py
# (falls back to Elastic's default managed chat endpoint if unset)
CHAT_INFERENCE_ID=.rainbow-sprinkles-elastic

# Index name — leave as-is unless you want to rebuild fresh
INDEX_NAME=wc2026_players
